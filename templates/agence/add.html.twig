{% extends 'base.html.twig' %}

{% block title %}Gestion des Agences{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-10">
    <h1 class="text-3xl font-bold text-center mb-8">Créer une Agence</h1>

    {{ form_start(form, { 'attr': { 'class': 'space-y-6 max-w-lg mx-auto bg-white p-8 shadow-lg rounded-xl' } }) }}

        <div class="flex flex-col">
            {{ form_label(form.numero, 'Numéro de l’agence', {'label_attr': { 'class': 'mb-2 font-semibold' }}) }}
            {{ form_widget(form.numero, { 'attr': { 'class': 'border border-gray-300 rounded-lg px-4 py-2 focus:ring focus:ring-indigo-300 w-full' } }) }}
            {{ form_errors(form.numero, { 'attr': { 'class': 'text-red-500 text-sm mt-1' } }) }}
        </div>

        <div class="flex flex-col">
            {{ form_label(form.adresse, 'Adresse', {'label_attr': { 'class': 'mb-2 font-semibold' }}) }}
            {{ form_widget(form.adresse, { 'attr': { 'class': 'border border-gray-300 rounded-lg px-4 py-2 focus:ring focus:ring-indigo-300 w-full' } }) }}
            {{ form_errors(form.adresse, { 'attr': { 'class': 'text-red-500 text-sm mt-1' } }) }}
        </div>

        <div class="flex flex-col">
            {{ form_label(form.telephone, 'Téléphone', {'label_attr': { 'class': 'mb-2 font-semibold' }}) }}
            {{ form_widget(form.telephone, { 'attr': { 'class': 'border border-gray-300 rounded-lg px-4 py-2 focus:ring focus:ring-indigo-300 w-full' } }) }}
            {{ form_errors(form.telephone, { 'attr': { 'class': 'text-red-500 text-sm mt-1' } }) }}
        </div>

        <div class="text-center">
            <button type="submit" class="bg-indigo-500 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg">
                Enregistrer
            </button>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}
